# Skrypty lokalne (nie wchodzą do repo)
git-push.sh
release-update.sh

# Pliki środowiskowe
.env
.env.*

# Build outputs (generowane przez build.ps1 / MSBuild)
build/bin/sftpplug.zip
build/bin/sftpplug-installer.zip
build/bin/*.wfx64
build/bin/*.wfx
build/bin/tc-installer/64/

# MSBuild intermediate / output directories
build/x64/
build/Debug/
build/Release/
*.user

# IDE
.vs/
*.aps
*.ncb
*.suo
*.sdf
*.opensdf
.idea/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# thirdparty build artifacts (rebuilt by build-deps.ps1)
# Submodule sources live in thirdparty/{openssl,libssh2}/ and are tracked via .gitmodules.
# Out-of-tree build dirs and downloaded tools are local-only.
thirdparty/build/
thirdparty/tools/
thirdparty/build-deps.log
build.log

# Static libs produced by build-deps.ps1 from OpenSSL + libssh2 submodule sources.
# Not tracked: ~107 MB of binaries that any contributor can regenerate locally.
# argon2_a_*.lib stays tracked (no build script in this repo for it).
src/lib/libssh2_*.lib
src/lib/libcrypto_*.lib
thirdparty/build-deps.log
build.log

# Archiwa lokalne
*.7z
*.tar.gz
